<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SPOTLIGHT Fire TV WebView wrapper skeleton.
         Loads the hosted SPOTLIGHT web app full-screen on Fire OS.
         Build with Android Studio: File > New > New Module > Android Library,
         or drop into a blank "No Activity" project and point MainActivity at the URL. -->
    <application
        android:label="SPOTLIGHT"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.Leanback">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
