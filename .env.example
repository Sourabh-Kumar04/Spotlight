# SPOTLIGHT — copy to .env and fill in what you have.
# Everything is optional: the app boots and the full demo tour works with zero keys.

# --- Server ---
SPOTLIGHT_HOST=0.0.0.0
SPOTLIGHT_PORT=8000
SPOTLIGHT_DEBUG=0  # set to 1 to enable the /health debug page

# --- LLM fallback chain (Bedrock -> OpenAI -> Ollama -> built-in synthesis) ---
# AWS Bedrock (preferred for the AWS Builder mini-challenge; uses default AWS credential chain)
AWS_REGION=us-east-1
BEDROCK_MODEL=amazon.nova-lite-v1:0
BEDROCK_VISION_MODEL=amazon.nova-lite-v1:0
# OpenAI (optional second provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Ollama (optional local provider; pull llama3.2:3b and llava to enable)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llava

# --- Voice (both optional; the app degrades gracefully without them) ---
# faster-whisper for speech-to-text (pip install faster-whisper); falls back to typed questions
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Piper TTS binary for server-side voice replies; falls back to browser speechSynthesis
PIPER_BINARY=
PIPER_VOICE_MODEL=

# --- News fact-check (optional; beat 4 uses curated verdicts without it) ---
FACTCHECK_API_KEY=
